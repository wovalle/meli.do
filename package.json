{
  "name": "meli-do",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && npm run db:migrate:remote && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply meli-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meli-db --remote",
    "db:seed:local": "wrangler d1 execute meli-db --local --file scripts/seed-local.sql",
    "setup:access": "node scripts/setup-access.mjs",
    "generate-types": "wrangler types",
    "import:wix": "node scripts/import-wix.mjs",
    "import:wix:dry": "node scripts/import-wix.mjs --dry-run",
    "import:behance": "node scripts/import-behance.mjs",
    "import:behance:dry": "node scripts/import-behance.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "nanoid": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.85.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
