{
  "name": "meli-do",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply meli-do-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meli-do-db --remote",
    "setup:access": "node scripts/setup-access.mjs",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.1",
    "astro": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.85.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
