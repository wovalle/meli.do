---
import wordmark from '../../public/brand/mellen-wordmark.svg?raw';
import { inlineWordmark } from '../lib/logo';
---
<a href="/" class="site-logo flex items-center"><Fragment set:html={inlineWordmark(wordmark)} /></a>

<script>
  // El giro every 9 s: one 1.2 s turn, then no animation at all until the next.
  const logo = document.querySelector<HTMLElement>('.site-logo');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  if (logo) {
    const turn = (): void => {
      if (still.matches || document.hidden) return;
      logo.classList.remove('is-turning');
      void logo.offsetWidth; // restart even if the last turn was interrupted
      logo.classList.add('is-turning');
    };
    logo.addEventListener('animationend', () => logo.classList.remove('is-turning'));
    turn();
    setInterval(turn, 9000);
  }
</script>
