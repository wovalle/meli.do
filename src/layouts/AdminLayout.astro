---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const email = Astro.locals.accessUser?.email ?? "unknown";

const status = Astro.url.searchParams.get("status");
const errorMsg = Astro.url.searchParams.get("error");

const flash = (() => {
  if (errorMsg) return { tone: "error" as const, msg: errorMsg };
  if (status === "created") return { tone: "ok" as const, msg: "Case study created." };
  if (status === "saved") return { tone: "ok" as const, msg: "Saved." };
  if (status === "deleted") return { tone: "ok" as const, msg: "Deleted." };
  if (status === "published") return { tone: "ok" as const, msg: "Published." };
  if (status === "block-added") return { tone: "ok" as const, msg: "Block added." };
  if (status === "block-deleted") return { tone: "ok" as const, msg: "Block deleted." };
  if (status === "moved") return { tone: "ok" as const, msg: "Reordered." };
  return null;
})();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · admin · meli.do</title>
  </head>
  <body class="min-h-dvh bg-stone-50 text-stone-900 font-sans antialiased" style="font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;">
    <header class="border-b border-stone-200 bg-white">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <a href="/admin" class="font-semibold text-stone-900 hover:text-stone-600">meli.do · admin</a>
        <div class="flex items-center gap-4 text-sm text-stone-600">
          <span class="hidden sm:inline">{email}</span>
          <a href="/cdn-cgi/access/logout" class="text-stone-500 hover:text-stone-900 underline underline-offset-2">Sign out</a>
        </div>
      </div>
    </header>

    {flash && (
      <div role="status" aria-live="polite" class={`max-w-5xl mx-auto px-6 mt-4`}>
        <div class={flash.tone === "error"
          ? "rounded-lg border border-red-200 bg-red-50 text-red-900 px-4 py-3 text-sm"
          : "rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-900 px-4 py-3 text-sm"}>
          {flash.msg}
        </div>
      </div>
    )}

    <main class="max-w-5xl mx-auto px-6 py-8">
      <slot />
    </main>
  </body>
</html>
