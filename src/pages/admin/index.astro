    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>admin · meli.do</title>
    <style>
      body { font-family: ui-monospace, SFMono-Regular, monospace; max-width: 60ch; margin: 10vh auto; padding: 0 24px; color: #0a0a0a; }
      h1 { font-size: 24px; margin: 0 0 16px; }
      code { background: #f0eee8; padding: 2px 6px; }
    </style>
  </head>
  <body>
    <h1>admin</h1>
