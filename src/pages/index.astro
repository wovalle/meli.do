---
import { drizzle } from 'drizzle-orm/d1';
import { eq, desc, inArray, and, asc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import PublicLayout from '../layouts/PublicLayout.astro';
import { caseStudies, blocks } from '../db/schema';
import { imgSrc, imgSrcset, thumbSrc, thumbSrcset } from '../lib/img';
import { projectAlt } from '../lib/alt';
import { DISCIPLINES } from '../lib/disciplines';
import { POLAROID_PHOTOS, POLAROID_CAPTIONS, SABOR_DEFAULT, saborSparkPool } from '../lib/play/toys';
import { seededRandom } from '../lib/play/motion';
import { SERVICES, CONTACT_EMAIL } from '../lib/play/postcard';
import '../styles/play.css';

const db = drizzle((env as { db: D1Database }).db);

const published = await db
  .select()
  .from(caseStudies)
  .where(eq(caseStudies.status, 'published'))
  .orderBy(desc(caseStudies.featured), asc(caseStudies.sortOrder), desc(caseStudies.publishedAt))
  .all();

const studyIds = published.map((s) => s.id);
const firstBlocks = studyIds.length
  ? await db
      .select()
      .from(blocks)
      .where(and(inArray(blocks.caseStudyId, studyIds), eq(blocks.position, 0)))
      .all()
  : [];
const thumbByStudy = new Map(firstBlocks.map((b) => [b.caseStudyId, b]));

const cardColors = ['butter', 'coral', 'mint', 'sky'];

const saborSparks = saborSparkPool(seededRandom(7));

const polaroidPhotos = POLAROID_PHOTOS.map((p) => ({
  src: thumbSrc(p.key, 800, 4 / 5),
  srcset: thumbSrcset(p.key, 4 / 5),
  alt: p.alt,
}));

Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=86400');
---
<PublicLayout title="Melissa Encarnación | Art Director & Designer in Santo Domingo">

  <section class="relative pt-16 lg:pt-24 pb-24 lg:pb-32 overflow-hidden">
    <div class="max-w-shell mx-auto px-6 lg:px-10 relative">

      <svg data-sparkle aria-hidden="true" class="absolute -top-6 right-[12%] float-a" width="48" height="48" viewBox="0 0 48 48" fill="none">
        <path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z" fill="#FF1392" data-sparkle-paint />
      </svg>
      <svg data-sparkle aria-hidden="true" class="absolute top-[40%] -left-2 lg:left-8 float-b" width="60" height="60" viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="20" fill="none" stroke="#FF7F50" stroke-width="3" stroke-dasharray="4 6" data-sparkle-paint />
      </svg>
      <svg data-sparkle aria-hidden="true" class="absolute top-[18%] right-0 float-c" width="96" height="96" viewBox="0 0 96 96" fill="none">
        <path d="M48 6 Q 60 30 84 40 Q 60 50 48 84 Q 36 50 12 40 Q 36 30 48 6 Z" fill="#FFE484" data-sparkle-paint />
      </svg>

      <div class="flex flex-wrap items-center gap-3 soft-up">
        <span class="bg-cream rounded-pill px-4 py-1.5 text-[12px] font-medium flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-coral inline-block animate-pulse"></span>
          Open for 2026 projects
        </span>
        <span class="bg-hot-pink text-cream rounded-pill px-4 py-1.5 text-[12px] font-medium">10 years designing</span>
      </div>

      <h1 aria-label="¡Hola! I'm Melissa, an art director who loves sabor." class="font-display text-[64px] sm:text-[96px] lg:text-[152px] leading-[0.95] tracking-[-0.02em] mt-4 lg:mt-8 mb-8 lg:mb-0 soft-up d-100">
        ¡Hola! <span class="wave inline-block">👋🏽</span><br/>
        I'm <span class="italic text-hot-pink">Melissa</span>,<br/>
        an <span class="hand-underline">art director</span><br/>
        who loves <span class="sabor"><em class="sabor-word font-display"><span class="sabor-ink">sabor</span><span class="sabor-ink-pink" aria-hidden="true">sabor</span></em><span class="sabor-sparks" aria-hidden="true">{saborSparks.map((p) => (
          <span class="sabor-spark" style={`left:${p.left}%;top:${p.top}%;width:${p.size}px;height:${p.size}px;--on:${p.on}`}><svg
            viewBox="0 0 48 48" class={`sabor-twinkle-${p.path}`} style={`animation-duration:${p.durationMs}ms;animation-delay:${p.delayMs}ms`}
          ><path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z" fill={p.color === 'butter' ? '#FFE484' : '#FF1392'} stroke="rgba(26,43,74,0.28)" stroke-width="1.5" stroke-linejoin="round" /></svg></span>
        ))}</span><input
          type="range" min="0" max="100" value={SABOR_DEFAULT} step="1" hidden data-sabor-dial
          class="sabor-dial" aria-label="Sabor: slide for more italic, hotter pink and a faster marquee"
        /><span class="sabor-thumb-rail" aria-hidden="true"><span class="sabor-thumb"></span></span></span>.
      </h1>

      <div class="mt-12 lg:mt-16 grid grid-cols-12 gap-6 lg:gap-10 items-end">
        <p class="col-span-12 lg:col-span-7 text-[18px] lg:text-[22px] leading-[1.55] max-w-[40ch] soft-up d-200">
          I'm a Dominican designer leading a design team at Liquid Digital Agency. For the past decade I've been building brand systems that feel warm, specific, and a little bit homemade, even when they're running at scale.
        </p>

        <div class="col-span-12 lg:col-span-5 flex flex-col gap-3 soft-up d-300">
          <div class="flex flex-wrap gap-3">
            <a href="#work" class="bg-navy text-cream rounded-pill px-6 py-3 text-[14px] font-medium hover:bg-hot-pink transition">See my work →</a>
            <a href="#contact" class="bg-cream border border-navy/20 rounded-pill px-6 py-3 text-[14px] font-medium hover:bg-butter transition">Let's collab ✦</a>
          </div>
          <a href="/work" class="font-hand text-[18px] text-navy/70 hover:text-hot-pink transition self-start ml-1">
            or browse the archive →
          </a>
        </div>
      </div>

    </div>
  </section>

  <section class="py-6 border-y border-navy/10 bg-cream overflow-hidden" data-marquee aria-label="Disciplines: pick one to filter the archive">
    <div class="marquee flex gap-10 whitespace-nowrap text-navy/70 font-display text-[28px] lg:text-[44px] italic" data-marquee-track>
      {[false, true].map((dupe) => (
        <ul class="flex gap-4 shrink-0 list-none m-0 p-0" aria-hidden={dupe ? 'true' : undefined}>
          {DISCIPLINES.map((d) => (
            <li class="flex gap-4">
              <span aria-hidden="true">✦</span>
              <a href={`/work?d=${d.slug}`} tabindex={dupe ? -1 : undefined}>{d.label}</a>
            </li>
          ))}
          <li aria-hidden="true">✦</li>
        </ul>
      ))}
    </div>
  </section>

  <section id="about" class="py-20 lg:py-28">
    <div class="max-w-shell mx-auto px-6 lg:px-10 grid grid-cols-12 gap-6 lg:gap-10 items-start">

      <div class="col-span-12 md:col-span-5 lg:col-span-4 relative">
        <div
          data-polaroid
          data-photos={JSON.stringify(polaroidPhotos)}
          role="button"
          tabindex="0"
          aria-label="Polaroid of Melissa: click, tap or shake it for another caption"
        >
          <div class="bg-cream p-4 pb-10 rounded-xxl shadow-[0_30px_60px_-30px_rgba(26,43,74,.3)] rotate-[-3deg] lift">
            <div class="aspect-[4/5] bg-navy rounded-[18px] overflow-hidden relative flex items-end p-5">
              <img
                data-polaroid-img
                class="absolute inset-0 w-full h-full object-cover"
                src={polaroidPhotos[0]?.src}
                srcset={polaroidPhotos[0]?.srcset}
                sizes="(max-width: 768px) 90vw, 400px"
                alt={polaroidPhotos[0]?.alt}
                loading="eager"
               
                draggable="false"
              />
              <div class="w-full relative">
                <div data-polaroid-caption aria-live="polite" class="polaroid-caption font-hand text-[20px] lg:text-[22px] leading-[1.25]">{POLAROID_CAPTIONS[0]}</div>
              </div>
            </div>
            <div class="font-hand text-[22px] text-navy text-center mt-3">Santo Domingo, 2026</div>
          </div>
        </div>
        <p hidden data-polaroid-hint aria-hidden="true" class="polaroid-hint absolute -top-9 left-3 rotate-[-5deg] font-hand text-[18px] text-hot-pink pointer-events-none">
          <span class="on-mouse">click me</span><span class="on-touch">tap me</span> ✦ ↓
        </p>
        <svg data-sparkle aria-hidden="true" class="absolute -top-6 -right-4 float-a" width="80" height="80" viewBox="0 0 48 48" fill="none">
          <path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z" fill="#FF7F50" data-sparkle-paint />
        </svg>
      </div>

      <div class="col-span-12 md:col-span-7 lg:col-span-8 space-y-8">
        <h2 class="font-display text-[44px] lg:text-[80px] leading-[0.95]">
          A decade of brand work,<br/>grounded in <span class="italic text-hot-pink">Caribbean warmth</span>.
        </h2>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-butter rounded-xxl p-6">
            <div class="font-display text-[44px] lg:text-[56px] leading-none tabular-nums">10+</div>
            <div class="text-[12px] font-medium mt-2 uppercase tracking-wider text-navy/70">years of brand work</div>
          </div>
          <div class="bg-sky rounded-xxl p-6">
            <div class="font-display text-[44px] lg:text-[56px] leading-none">EN · ES</div>
            <div class="text-[12px] font-medium mt-2 uppercase tracking-wider text-navy/70">English &amp; Spanish</div>
          </div>
        </div>

        <div class="bg-cream rounded-xxl p-6 lg:p-8">
          <p class="text-[16px] lg:text-[18px] leading-[1.7]">
            I lead a design team at <strong>Liquid Digital Agency</strong> in Santo Domingo. Our work ranges from FMCG and finance to cultural and small founder-led brands. I care about craft, but more than anything, I care about whether a brand <em>feels</em> like where it's from, like it knows who it's talking to.
          </p>
          <div class="flex flex-wrap gap-2 mt-6">
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Brand Identity</span>
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Art Direction</span>
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Packaging</span>
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Editorial</span>
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Campaigns</span>
            <span class="bg-lavender rounded-pill px-3 py-1 text-[12px] font-medium">Team leadership</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="py-20 lg:py-28 bg-cream border-y border-navy/10">
    <div class="max-w-shell mx-auto px-6 lg:px-10">

      <div class="flex flex-wrap items-end justify-between gap-6 mb-12 lg:mb-16">
        <div>
          <a href="/work" class="font-hand text-[28px] lg:text-[36px] text-hot-pink hover:underline underline-offset-4 decoration-2 transition">selected work</a>
        </div>
        {published.length > 0 && (
          <a href="/work" class="group hidden md:inline-flex items-center gap-2 text-[14px] font-medium border-b-2 border-navy pb-1 hover:text-hot-pink hover:border-hot-pink transition">
            Browse the archive
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        )}
      </div>

      {published.length === 0 ? (
        <div class="text-center py-16">
          <p class="font-hand text-[28px] text-navy/60">new case studies in the studio</p>
        </div>
      ) : (
        <>
          {published.slice(0, 2).map((s, idx) => {
            const thumb = thumbByStudy.get(s.id);
            const isReversed = idx % 2 === 1;
            const accent = idx === 0 ? 'hot-pink' : 'coral';
            const number = String(idx + 1).padStart(2, '0');
            return (
              <article class={`grid grid-cols-12 gap-6 lg:gap-10 items-stretch mb-10 lg:mb-14`}>
                <div class={`col-span-12 md:col-span-7 lg:col-span-8 relative lift ${isReversed ? 'order-1 md:order-2' : ''}`}>
                  <a href={`/work/${s.slug}`} class="block rounded-xxl overflow-hidden border border-navy/10 bg-navy aspect-[4/3] md:aspect-[16/10]">
                    {thumb ? (
                      <img class="w-full h-full object-cover" src={imgSrc(thumb.imageLKey, 1200)} srcset={imgSrcset(thumb.imageLKey)} sizes="(max-width: 768px) 100vw, 66vw" alt={projectAlt(thumb.altL, s.title)} loading="eager" fetchpriority={idx === 0 ? 'high' : 'low'} />
                    ) : (
                      <div class="w-full h-full bg-navy"></div>
                    )}
                  </a>
                </div>
                <div class={`col-span-12 md:col-span-5 lg:col-span-4 flex flex-col justify-between gap-6 ${isReversed ? 'order-2 md:order-1' : ''}`}>
                  <div>
                    <div class="flex items-center gap-3">
                      <span class={`bg-${accent} text-cream rounded-pill px-3 py-1 text-[11px] font-semibold`}>{number} · Featured</span>
                      {s.publishedAt && (
                        <span class="text-[12px] text-navy/60">
                          {new Date(s.publishedAt).toLocaleDateString(undefined, { month: 'short', year: 'numeric' })}
                        </span>
                      )}
                    </div>
                    <h3 class="font-display text-[40px] lg:text-[56px] leading-[0.95] mt-4">{s.title}</h3>
                    {s.summary && (
                      <p class="text-[15px] leading-[1.65] mt-4 text-navy/80">{s.summary}</p>
                    )}
                  </div>
                  <div>
                    <a href={`/work/${s.slug}`} class="mt-5 inline-flex items-center gap-2 font-medium text-[14px] border-b border-navy pb-0.5 hover:text-hot-pink hover:border-hot-pink transition">
                      Read the case study →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}

          {published.length > 2 && (
            <div class="mt-16 flex justify-end">
              <button
                type="button"
                hidden
                data-scatter-toggle
                aria-pressed="false"
                class="relative z-30 inline-flex items-center gap-2 bg-lavender border border-navy/15 rounded-pill px-5 py-2 text-[13px] font-medium hover:bg-butter transition"
              >
                <span aria-hidden="true">✦</span><span data-scatter-label>scatter</span>
              </button>
            </div>
            <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6" data-scatter-grid>
              {published.slice(2, 8).map((s, idx) => {
                const thumb = thumbByStudy.get(s.id);
                const color = cardColors[idx % cardColors.length];
                return thumb ? (
                  <a href={`/work/${s.slug}`} aria-label={s.title} draggable="false" data-scatter-tile class={`rounded-xxl overflow-hidden aspect-square bg-${color} lift block`}>
                    <img class="w-full h-full object-cover" src={thumbSrc(thumb.imageLKey, 800, 1)} srcset={thumbSrcset(thumb.imageLKey, 1, [400, 600, 800])} sizes="(max-width: 768px) 50vw, 25vw" alt={projectAlt(thumb.altL, s.title)} loading="eager" fetchpriority="low" draggable="false" />
                  </a>
                ) : (
                  <a href={`/work/${s.slug}`} draggable="false" data-scatter-tile class={`rounded-xxl aspect-square bg-${color} p-5 lift flex flex-col justify-between text-navy`}>
                    <div class="text-[11px] font-medium opacity-70">
                      {s.publishedAt ? new Date(s.publishedAt).toLocaleDateString(undefined, { year: 'numeric' }) : ''}
                    </div>
                    <div class="font-display text-[28px] leading-[0.95]">{s.title}</div>
                    <div class="text-[12px] opacity-70">Case study →</div>
                  </a>
                );
              })}
            </div>
          )}

          <div class="mt-12 lg:mt-16 flex justify-center">
            <a href="/work" class="group relative inline-flex items-center gap-3 bg-navy text-cream rounded-pill pl-7 pr-6 py-4 text-[14px] font-medium hover:bg-hot-pink transition shadow-[0_20px_40px_-20px_rgba(26,43,74,.45)]">
              <span>View the full archive</span>
              <span class="bg-cream text-navy rounded-full w-6 h-6 inline-flex items-center justify-center text-[11px] font-semibold">{published.length}</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </>
      )}
    </div>
  </section>

  <section id="contact" class="py-20 lg:py-32 bg-hot-pink text-cream relative overflow-hidden">
    <svg class="absolute top-10 left-[8%] spin-slow pointer-events-none" width="80" height="80" viewBox="0 0 48 48"><path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z" fill="#FFE484" /></svg>
    <svg class="absolute -bottom-8 -right-8 spin-slow pointer-events-none" width="120" height="120" viewBox="0 0 48 48" style="animation-direction:reverse"><path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z" fill="#1A2B4A" /></svg>

    <div class="max-w-shell mx-auto px-6 lg:px-10 relative">
      <div class="max-w-[920px] mx-auto">

        <div class="font-hand text-[28px] lg:text-[36px] text-butter text-center">let's make something warm</div>

        <div class="mt-6 postcard-scene rotate-[-1deg]" data-postcard>
          <div class="tape tape-r postcard-tape" style="top:-14px; left:44%; width:140px; height:28px;"></div>

          <div class="postcard-mail">
            <div class="envelope envelope-back" data-postcard-envelope aria-hidden="true"></div>

            <div class="postcard-flipper" data-postcard-flipper>
              <!-- front: the original card; its mailto link works with or without JS -->
              <div class="postcard-face postcard-front airmail-frame rounded-xxl p-[7px] shadow-[0_30px_60px_-30px_rgba(26,43,74,.45)]" data-postcard-front>
                <div class="bg-cream text-navy rounded-[18px] p-6 sm:p-8 lg:p-12 h-full">
                <div class="grid grid-cols-12 gap-4 lg:gap-8">
                  <div class="col-span-12 md:col-span-7 md:pr-8 md:border-r-2 md:border-dashed md:border-navy/30">
                    <div class="font-hand text-[28px] text-hot-pink">Dear Melissa,</div>

                    <h2 class="font-display text-[44px] sm:text-[64px] lg:text-[88px] leading-[0.95] mt-3">
                      Write me<br/>a <em class="text-hot-pink">love letter</em>.
                    </h2>

                    <p class="mt-6 font-hand text-[22px] text-navy/75">
                      A project, a collab, or just design in general,<br/>
                      I'd love to hear from you.
                    </p>

                    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
                      <button type="button" hidden data-postcard-flip class="bg-hot-pink text-cream rounded-pill px-6 py-3 text-[14px] font-medium hover:bg-navy transition">
                        Write it on the back ✦
                      </button>
                      <a href={`mailto:${CONTACT_EMAIL}`} class="inline-block font-display italic text-[22px] lg:text-[28px] border-b-2 border-navy hover:text-hot-pink hover:border-hot-pink transition">
                        {CONTACT_EMAIL} →
                      </a>
                      <button type="button" hidden data-copy-email={CONTACT_EMAIL} class="rounded-pill border border-navy/20 px-3 py-1 text-[12px] font-medium hover:bg-butter transition">copy</button>
                    </div>
                  </div>

                  <div class="col-span-12 md:col-span-5 md:pl-4 mt-2 pt-6 border-t-2 border-dashed border-navy/25 md:mt-0 md:pt-0 md:border-t-0">
                    <div class="flex flex-row items-start justify-between gap-4 md:flex-col md:items-end">
                      <div class="stamp-perf p-4 pt-5 pb-5 bg-butter rotate-[4deg] inline-block w-[132px] sm:w-[148px] text-center flex-none">
                        <div class="font-hand text-[22px] text-hot-pink leading-[1]">postal<br/>express</div>
                        <div class="font-display italic text-[18px] mt-2">MDO · DR</div>
                        <div class="font-hand text-[14px] mt-1 text-navy/60">2026</div>
                      </div>
                      <div class="font-hand text-[18px] text-navy/80 text-right leading-[1.5] md:mt-6">
                        To:<br/>
                        <span class="text-navy text-[22px]">future client ✦</span><br/>
                        anywhere, everywhere<br/>
                        the world, 00000
                      </div>
                    </div>
                  </div>
                </div>
                </div>
              </div>

              <!-- back: the writing side (JS only) -->
              <div class="postcard-face postcard-back airmail-frame rounded-xxl p-[7px] shadow-[0_30px_60px_-30px_rgba(26,43,74,.45)]" data-postcard-back hidden inert aria-hidden="true">
                <form class="bg-cream text-navy rounded-[18px] p-6 sm:p-8 lg:p-12 h-full" data-postcard-form>
                <div class="grid grid-cols-12 gap-4 lg:gap-8">
                  <div class="col-span-12 md:col-span-7 md:pr-8 md:border-r-2 md:border-dashed md:border-navy/30">
                    <div class="font-hand text-[28px] text-hot-pink">Dear Melissa,</div>

                    <label class="block mt-4">
                      <span class="font-hand text-[18px] text-navy/70">my name is</span>
                      <input name="name" required maxlength="80" autocomplete="name" class="postcard-line" placeholder="your name" />
                    </label>

                    <label class="block mt-4">
                      <span class="font-hand text-[18px] text-navy/70">and I'd love your help with</span>
                      <textarea name="project" required rows="3" maxlength="1200" class="postcard-lines" placeholder="a rebrand, a label, a love letter back…"></textarea>
                    </label>

                    <fieldset class="mt-3">
                      <legend class="font-hand text-[18px] text-navy/70">what are we making? <span class="text-navy/45">(pick any)</span></legend>
                      <div class="mt-2 flex flex-wrap gap-2">
                        {SERVICES.map((sv) => (
                          <label class="inline-flex items-center gap-1.5 rounded-pill border border-navy/20 px-3 py-1.5 text-[13px] font-medium cursor-pointer transition hover:bg-butter has-checked:bg-hot-pink has-checked:text-cream has-checked:border-hot-pink has-focus-visible:outline-2 has-focus-visible:outline-dashed has-focus-visible:outline-hot-pink">
                            <input type="checkbox" name="services" value={sv.value} class="sr-only" />
                            <span aria-hidden="true" class="service-tick">✦</span>
                            {sv.label}
                          </label>
                        ))}
                      </div>
                    </fieldset>

                    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
                      <button type="submit" class="bg-hot-pink text-cream rounded-pill px-6 py-3 text-[14px] font-medium hover:bg-navy transition">
                        Stamp it &amp; send ✦
                      </button>
                      <button type="button" data-postcard-unflip class="font-hand text-[18px] text-navy/70 hover:text-hot-pink transition">
                        ← flip back
                      </button>
                    </div>
                    <p class="mt-4 text-[13px] text-navy/70">
                      No mail app? Write to <span class="font-medium text-navy select-all">{CONTACT_EMAIL}</span>
