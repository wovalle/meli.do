---
import { drizzle } from 'drizzle-orm/d1';
import { eq, desc, inArray, and, asc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import PublicLayout from '../layouts/PublicLayout.astro';
import { caseStudies, blocks } from '../db/schema';
import { imgSrc, imgSrcset, thumbSrc, thumbSrcset } from '../lib/img';

const db = drizzle((env as { db: D1Database }).db);

const published = await db
  .select()
  .from(caseStudies)
  .where(eq(caseStudies.status, 'published'))
  .orderBy(desc(caseStudies.featured), asc(caseStudies.sortOrder), desc(caseStudies.publishedAt))
  .all();

const studyIds = published.map((s) => s.id);
const firstBlocks = studyIds.length
  ? await db
      .select()
      .from(blocks)
      .where(and(inArray(blocks.caseStudyId, studyIds), eq(blocks.position, 0)))
      .all()
  : [];
const thumbByStudy = new Map(firstBlocks.map((b) => [b.caseStudyId, b]));

const cardColors = ['butter', 'coral', 'mint', 'sky'];

Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=86400');
---
