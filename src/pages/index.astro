                      <div class="w-full h-full bg-navy"></div>
                    )}
                  </a>
                </div>
                <div class={`col-span-12 md:col-span-5 lg:col-span-4 flex flex-col justify-between gap-6 ${isReversed ? 'order-2 md:order-1' : ''}`}>
