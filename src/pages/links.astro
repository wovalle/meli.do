---
import PublicLayout from "../layouts/PublicLayout.astro";

const links = [
  {
    label: "Portfolio",
    handle: "mellen.do",
    href: "/",
    accent: "bg-navy",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>`,
  },
  {
    label: "Instagram",
    handle: "@mell.en",
    href: "https://instagram.com/mell.en",
    accent: "bg-gradient-to-br from-[#833AB4] via-[#E1306C] to-[#F77737]",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  },
  {
    label: "LinkedIn",
    handle: "@mellen",
    href: "https://www.linkedin.com/in/melissa-encarnación-108ab497/",
    accent: "bg-[#0A66C2]",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: "Email",
    handle: "hola@mellen.do",
    href: "mailto:hola@mellen.do",
    accent: "bg-hot-pink",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-white"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  },
];
---

<PublicLayout
  title="Links — Melissa Encarnación"
  description="Connect with Melissa Encarnación — Art Director & Head of Design."
>
  <section class="min-h-screen flex flex-col items-center justify-center py-20 px-6">
    <div class="w-full max-w-sm mx-auto">

      <!-- Profile -->
      <div class="flex flex-col items-center text-center mb-10 soft-up">
        <div class="relative w-24 h-24 rounded-full bg-gradient-to-br from-butter via-coral to-hot-pink border-4 border-white shadow-xl overflow-hidden mb-4 flex items-center justify-center">
          <span class="font-display italic text-[44px] text-cream leading-none">M</span>
          <span class="absolute -top-1 -right-1 w-5 h-5 bg-mint rounded-full border-2 border-white"></span>
        </div>
        <h1 class="font-display italic text-[28px] text-navy leading-tight">Melissa Encarnación</h1>
        <p class="font-hand text-[18px] text-hot-pink mt-1">Art Director & Head of Design</p>
        <p class="text-[13px] text-navy/50 mt-1">Santo Domingo, DR · AST (GMT-4)</p>
      </div>

      <!-- Links -->
      <div class="space-y-3 soft-up d-100">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="group flex items-center gap-4 w-full bg-white border border-navy/10 rounded-xxl px-5 py-4 shadow-sm hover:shadow-md hover:border-navy/20 transition-all duration-200 lift"
          >
            <div class={`flex-none flex items-center justify-center w-10 h-10 rounded-full ${link.accent} shadow-sm`} set:html={link.svg} />
            <div class="flex-1 min-w-0 text-left">
              <div class="font-medium text-navy text-[15px]">{link.label}</div>
              <div class="text-navy/50 text-[12px] truncate">{link.handle}</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-none w-4 h-4 text-navy/30 group-hover:text-navy/60 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-200">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
        ))}
      </div>

    </div>
  </section>
</PublicLayout>
