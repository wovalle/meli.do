---
import { drizzle } from 'drizzle-orm/d1';
import { eq, asc, desc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { caseStudies, blocks } from '../../db/schema';

export const prerender = false;

const db = drizzle((env as { db: D1Database }).db);

const { slug } = Astro.params as { slug: string };

const study = await db
  .select()
  .from(caseStudies)
  .where(eq(caseStudies.slug, slug))
  .get();

const isPreview = !!Astro.locals.accessUser;
if (!study || (study.status !== 'published' && !isPreview)) {
  return new Response(null, { status: 404 });
}

const [studyBlocks, allPublished] = await Promise.all([
  db
    .select()
    .from(blocks)
    .where(eq(blocks.caseStudyId, study.id))
    .orderBy(asc(blocks.position))
    .all(),
  db
    .select({ slug: caseStudies.slug, title: caseStudies.title })
    .from(caseStudies)
    .where(eq(caseStudies.status, 'published'))
    .orderBy(desc(caseStudies.publishedAt))
    .all(),
]);

const idx = allPublished.findIndex((s) => s.slug === slug);
const prev = idx > 0 ? allPublished[idx - 1] : null;
const next = idx >= 0 && idx < allPublished.length - 1 ? allPublished[idx + 1] : null;

const description = study.summary ?? `Case study by Melissa Encarnacion — ${study.title}`;
const isDraft = study.status !== 'published';

if (isDraft) {
  Astro.response.headers.set('cache-control', 'private, no-store');
} else {
  Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=86400');
}
---
<PublicLayout title={`${study.title} — Melissa Encarnacion`} description={description}>

  {isDraft && (
    <div class="bg-amber-100 border-b border-amber-300 text-amber-950">
      <div class="max-w-shell mx-auto px-6 lg:px-10 py-3 flex flex-wrap items-center justify-between gap-3 text-sm">
        <div class="flex items-center gap-2 font-medium">
          <span class="inline-flex rounded-full bg-amber-600 text-white px-2 py-0.5 text-[11px] uppercase tracking-wider">Draft</span>
          <span>Preview only — not published. Visible because you're signed in.</span>
        </div>
        <a href={`/admin/${study.id}`} class="underline underline-offset-2 hover:text-amber-700">Edit in admin →</a>
      </div>
    </div>
  )}

  <article class="pt-12 lg:pt-20 pb-20 lg:pb-28">
    <header class="max-w-shell mx-auto px-6 lg:px-10 mb-12 lg:mb-20">
      <a href="/#work" class="font-hand text-[22px] text-hot-pink hover:underline">← back to work</a>
      <h1 class="font-display text-[48px] sm:text-[80px] lg:text-[128px] leading-[0.95] tracking-[-0.02em] mt-4 soft-up">
        {study.title}
      </h1>
      {study.summary && (
        <p class="mt-6 text-[18px] lg:text-[22px] leading-[1.55] max-w-[60ch] text-navy/80 soft-up d-100">
          {study.summary}
        </p>
      )}
      {study.publishedAt && (
        <div class="mt-6 text-[12px] font-medium text-navy/60 uppercase tracking-wider soft-up d-200">
          Published {new Date(study.publishedAt).toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}
        </div>
      )}
    </header>

    {studyBlocks.length === 0 ? (
      <div class="max-w-shell mx-auto px-6 lg:px-10 text-center py-16">
        <p class="font-hand text-[28px] text-navy/60">— more soon —</p>
      </div>
    ) : (
      <div class="max-w-shell mx-auto px-6 lg:px-10 space-y-6 lg:space-y-10">
        {studyBlocks.map((b) => (
          b.layout === 'pair' && b.imageRKey ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10">
              <div class="rounded-xxl overflow-hidden bg-cream border border-navy/10">
                <img class="w-full h-auto block" src={`/images/${b.imageLKey}`} alt={b.altL} loading="lazy" />
              </div>
              <div class="rounded-xxl overflow-hidden bg-cream border border-navy/10">
                <img class="w-full h-auto block" src={`/images/${b.imageRKey}`} alt={b.altR ?? ''} loading="lazy" />
              </div>
            </div>
          ) : (
            <div class="rounded-xxl overflow-hidden bg-cream border border-navy/10">
              <img class="w-full h-auto block" src={`/images/${b.imageLKey}`} alt={b.altL} loading="lazy" />
            </div>
          )
        ))}
      </div>
    )}
  </article>

  {(prev || next) && (
    <nav class="border-t border-navy/10 bg-cream py-10 lg:py-14">
      <div class="max-w-shell mx-auto px-6 lg:px-10 grid grid-cols-2 gap-6">
        <div>
          {prev && (
            <a href={`/work/${prev.slug}`} class="block group">
              <div class="font-hand text-[18px] text-hot-pink">← previous</div>
              <div class="font-display text-[24px] lg:text-[36px] leading-[1.05] mt-2 group-hover:text-hot-pink transition">{prev.title}</div>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={`/work/${next.slug}`} class="block group">
              <div class="font-hand text-[18px] text-hot-pink">next →</div>
              <div class="font-display text-[24px] lg:text-[36px] leading-[1.05] mt-2 group-hover:text-hot-pink transition">{next.title}</div>
            </a>
          )}
        </div>
      </div>
    </nav>
  )}

</PublicLayout>
