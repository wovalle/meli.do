{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meli-do",
  "account_id": "d5705803ba3e46be8c7b0566e47ff7d6",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Set ACCESS_TEAM_DOMAIN and ACCESS_AUD via `wrangler secret put` for production.
    // ACCESS_TEAM_DOMAIN: "<team>.cloudflareaccess.com"
    // ACCESS_AUD: "<application-aud-tag>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meli-do-db",
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "meli-do-images"
    }
  ]
}
