{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meli-do",
	"account_id": "d5705803ba3e46be8c7b0566e47ff7d6",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Production lives on the custom domain only; non-main branches (Workers
	// Builds) and `wrangler versions upload` get a *-meli-do.wovalle.workers.dev
	// preview URL.
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{ "pattern": "mellen.do", "custom_domain": true },
		// www only exists to 301 to the apex (src/lib/security.ts); the custom
		// domain creates its DNS record on deploy.
		{ "pattern": "www.mellen.do", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		// Set ACCESS_TEAM_DOMAIN and ACCESS_AUD via `wrangler secret put` for production.
		// ACCESS_TEAM_DOMAIN: "<team>.cloudflareaccess.com"
		// ACCESS_AUD: "<application-aud-tag>"
	},
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "meli-db",
			"database_id": "7a887d11-8835-4fe7-9bc2-9f297067e7cb",
			"migrations_dir": "./drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "meli-do-images",
			"remote": true
		}
	]
}